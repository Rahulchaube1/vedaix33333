# ========================================
# Runtime & App URL
# ========================================
DATA_DIR=./data
NEXT_PUBLIC_APP_URL=https://vedaix.com
PORT=3000

# ========================================
# Authentication (Google & Auth0)
# ========================================
AUTH_SECRET=generate-a-long-random-secret

# Google OAuth
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# Auth0 OAuth
AUTH_AUTH0_ID=your-auth0-client-id
AUTH_AUTH0_SECRET=your-auth0-client-secret
AUTH_AUTH0_ISSUER=https://your-tenant.auth0.com

# ========================================
# Search Engines
# ========================================
# Options: auto, duckduckgo, searxng, tavily, brave
SEARCH_PROVIDER=auto
SEARXNG_API_URL=http://localhost:8080
TAVILY_API_KEY=
BRAVE_API_KEY=

# ========================================
# AI Models & Providers (Open-Source & Cloud)
# ========================================
# DeepSeek (V3 & R1 Reasoner)
DEEPSEEK_API_KEY=

# OpenRouter (All open-source + proprietary models)
OPENROUTER_API_KEY=

# Groq (Ultra-fast Llama 3.3, DeepSeek R1 Distill, Mixtral)
GROQ_API_KEY=

# OpenAI (GPT-4o, o1, o3-mini)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (Claude 3.5 Sonnet, Haiku, Opus)
ANTHROPIC_API_KEY=

# Google Gemini (Gemini 2.0 Flash, 1.5 Pro)
GEMINI_API_KEY=

# Mistral AI (Mistral Large, Codestral, NeMo, Embed)
MISTRAL_API_KEY=

# Together AI (Llama 3.3, DeepSeek R1/V3, Qwen 2.5)
TOGETHER_API_KEY=

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Local LM Studio
LM_STUDIO_BASE_URL=http://localhost:1234
